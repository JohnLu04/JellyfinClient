          }
        }
      }
    },
    "The server converts the video to H.264/AAC (MP4) at the chosen bitrate. Requires the transcoding permission. The download takes about as long as the server needs to transcode.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server wandelt das Video mit der gewählten Bitrate in H.264/AAC (MP4) um. Benötigt die Berechtigung zum Umwandeln. Der Download dauert etwa so lange wie die Umwandlung auf dem Server."
          }
        }
      }
    },
    "The server found no stream this iPhone can play.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat keinen Stream gefunden, den dieses iPhone abspielen kann."
